# Claude Code 视频创作流水线的忽略规则
# =================================

# 敏感信息
reference/cookies.txt
reference/**/cookies.txt
**/SESSDATA
**/bili_jct
*.cookie
*.cookies
.env
.env.local
secrets/

# 下载的视频/音频产物（很大且包含平台元数据）
reference/**/video.mp4
reference/**/video.mkv
reference/**/video.webm
reference/**/video.f*.mp4
reference/**/video.f*.m4a
reference/**/video.part
reference/**/audio.wav
reference/**/audio.mp3
reference/**/audio.m4a
reference/**/audio_hq.wav
reference/**/audio.json     # 转录原始 JSON（大且可重现）
reference/**/audio.srt      # 字幕文件（可重新生成）
reference/**/cuts.txt      # 镜头切换点列表
reference/**/rms.txt       # 响度包络（大）
reference/**/video.jpg
reference/**/video.png
reference/**/video.webp
reference/**/video.info.json
reference/**/*.info.json

# 抽帧图（小但量大 100+张，且 SOP 范例可手动生成）
reference/**/frames/
reference/**/montage_*.jpg
reference/**/_analysis/

# 参考视频的 montage/jpg 拼图
reference/**/*.jpg
!reference/**/.gitkeep

# 误生成的根目录文件（probe.ps1 旧 bug 修了，但万一又生成）
.reference*

# Python 虚拟环境
tools/.venv/
tools/.venv/**
tools/__pycache__/
tools/**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
*.egg-info/
.pytest_cache/

# Remotion node_modules
tools/remotion-hello/node_modules/
tools/remotion-hello/dist/
tools/remotion-hello/.cache/
tools/remotion-hello/build/
tools/remotion-hello/out.mp4
tools/remotion-hello/out.webm
tools/remotion-hello/*.mp4
tools/remotion-hello/*.webm
tools/remotion-hello/public/audio/*.wav
tools/remotion-hello/public/audio/*.mp3

# 临时文件
$TEMP/
*.tmp
*.temp
*.part
*.ytdl
*.aria2

# 数据采集的原始缓存
data/**/*.json
!data/**/videos_table.md
!data/**/README.md
!data/**/analysis.md
!data/**/videos.json

# 知识库缓存
.cache/
**/__pycache__/
*.log
npm-debug.log*
yt-dlp-*.log
ffmpeg-*.log

# 操作系统
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace

# Python 包构建
build/
dist/
*.egg
.eggs/
htmlcov/
.coverage
.tox/
.pytest_cache/

# NPM
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.eslintcache

# 外部学习参考（独立 clone，独立版本控制）
_refs/
data/我/              # 你的 B 站账号数据是私人
projects/active/      # 正在进行的私人项目
projects/**/audio/*.wav
projects/**/audio/*.mp3
projects/**/audio/mix_work/

# 临时工具源码（不下传 — 用完即删）
tools/weflow-src/

# TTS MVP (tools/tts-mvp)
# 独立 Python venv + 大模型权重 — 不入版本控制
tools/tts-mvp/.venv/
tools/tts-mvp/.venv/**
tools/tts-mvp/models/
tools/tts-mvp/outputs/*.wav
tools/tts-mvp/outputs/*.mp3
tools/tts-mvp/voices/**/*.wav
tools/tts-mvp/voices/**/*.mp3
tools/tts-mvp/voices/**/ref_*.bin
tools/tts-mvp/voices/**/ready/
tools/tts-mvp/voices/**/raw/
tools/tts-mvp/voices/**/_from_7z/
tools/tts-mvp/voices/**/_tmp*/
tools/tts-mvp/voices/**/_parquet_cache/
tools/tts-mvp/voices/**/_cache/
tools/tts-mvp/voices/**/_aihobbyist_datasets/
tools/tts-mvp/voices/**/_genshinvoice/
tools/tts-mvp/voices/**/_aliyun_index.json
!tools/tts-mvp/.gitkeep
!tools/tts-mvp/outputs/.gitkeep
!tools/tts-mvp/voices/.gitkeep
!tools/tts-mvp/tts.py
!tools/tts-mvp/README.md

# Nahida so-vits local voice conversion
# Keep docs/scripts, never commit checkpoints, generated audio, or cloned upstream repos.
nahida/**/*.pth
nahida/**/*.pt
nahida/**/*.zip
nahida/**/*.wav
nahida/**/*.mp3
nahida/sovits/input/
nahida/sovits/outputs/
nahida/sovits/batch/
nahida/sovits/logs/
nahida/sovits/.mplconfig/
!nahida/README.md
!nahida/sovits/configs/
!nahida/sovits/configs/**/
!nahida/sovits/configs/**/*.json
projects/so-vits-svc/
projects/qwen3-tts-xpu-v5-fork/

# Scratch / external app data
projects/_cos_triage/
projects/_jianying_data/
