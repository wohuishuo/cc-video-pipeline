{
  "schema_version": 1,
  "name": "credential-vault",
  "summary": "Protect local platform credentials and release one secret to one child process without exposing plaintext in files, output or argv.",
  "entrypoint": "run.ps1",
  "install": "install.ps1",
  "test": "python -m pytest --import-mode=importlib tests/credential_vault_mvp -q",
  "inputs": ["credential ID", "provider metadata", "secret environment variable", "child argv"],
  "outputs": ["atomic encrypted credential registry", "redacted lifecycle result", "child exit code"],
  "dependencies": ["windows>=10", "python>=3.12"],
  "delivery_level": "DOMAIN_VERIFIED"
}
